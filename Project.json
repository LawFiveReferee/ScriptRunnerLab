{
  "configs": {
    "Debug": "debug",
    "Release": "release"
  },
  "name": "ScriptRunnerLab",
  "packages": {
    "ScriptRunnerKit": {
      "path": "Packages/ScriptRunnerKit"
    }
  },
  "options": {
    "deploymentTarget": {
      "macOS": "15.0"
    },
    "groupSortPosition": "bottom",
    "transitivelyLinkDependencies": false
  },
  "settings": {
    "CODE_SIGN_IDENTITY": "-"
  },
  "targets": {
    "ScriptRunnerLab": {
      "dependencies": [
        {
          "package": "ScriptRunnerKit"
        },
        {
          "codeSign": true,
          "copy": {
            "destination": "wrapper",
            "subpath": "Contents/Helpers"
          },
          "embed": true,
          "link": false,
          "target": "ScriptRunnerLabHelper"
        }
      ],
      "info": {
        "path": "App/Info.plist",
        "properties": {
          "CFBundleDisplayName": "Script Runner Lab",
          "CFBundleShortVersionString": "1.0",
          "CFBundleVersion": "5",
          "ITSAppUsesNonExemptEncryption": false,
          "LSApplicationCategoryType": "public.app-category.developer-tools"
        }
      },
      "platform": "macOS",
      "settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CURRENT_PROJECT_VERSION": "5",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "org.scriptrunnerlab.app",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_VERSION": "5.0"
      },
      "sources": [
        {
          "path": "App"
        },
        {
          "buildPhase": "resources",
          "excludes": [
            "**/.DS_Store"
          ],
          "path": "CompatibilityTests",
          "type": "folder"
        }
      ],
      "type": "application"
    },
    "ScriptRunnerLabHelper": {
      "dependencies": [
        {
          "package": "ScriptRunnerKit"
        }
      ],
      "info": {
        "path": "Helper/Info.plist",
        "properties": {
          "CFBundleDisplayName": "ScriptRunnerHelper",
          "CFBundleShortVersionString": "1.0",
          "CFBundleVersion": "5",
          "LSUIElement": true
        }
      },
      "platform": "macOS",
      "settings": {
        "CURRENT_PROJECT_VERSION": "5",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "org.scriptrunnerlab.helper",
        "PRODUCT_NAME": "ScriptRunnerHelper",
        "SKIP_INSTALL": "YES",
        "SWIFT_VERSION": "5.0"
      },
      "sources": [
        {
          "path": "Helper"
        }
      ],
      "type": "application"
    }
  }
}
